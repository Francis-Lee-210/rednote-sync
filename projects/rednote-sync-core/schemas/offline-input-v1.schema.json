{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rednote-sync:schema:offline-input-v1",
  "title": "Rednote Sync offline-input-v1 explanatory schema",
  "$comment": "FixtureSession's runtime decoder is authoritative. This schema documents the exact field surface but cannot express normalization, canonical URL, digest, account/scope, item/detail, cursor uniqueness, or retry provenance invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "account", "pages", "retryItems"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "enum": ["fixture", "import-json"] },
    "account": { "$ref": "#/$defs/account" },
    "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } },
    "retryItems": { "type": "array", "items": { "$ref": "#/$defs/retryItem" } }
  },
  "$defs": {
    "host": { "enum": ["xhs", "rednote"] },
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!\\.{1,2}$)[^\\u0000-\\u001f\\u007f/\\\\]+$"
    },
    "isoTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableText": { "type": ["string", "null"] },
    "nullableTime": { "oneOf": [{ "$ref": "#/$defs/isoTime" }, { "type": "null" }] },
    "nullableCursor": { "oneOf": [{ "$ref": "#/$defs/safeId" }, { "type": "null" }] },
    "metric": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, { "type": "null" }] },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*\/$)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*//)(?!.*[\\\\\\u0000-\\u001f\\u007f]).+$"
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "accountId", "hostId", "displayName", "firstSeenAt", "lastSeenAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "accountId": { "$ref": "#/$defs/safeId" },
        "hostId": { "$ref": "#/$defs/host" },
        "displayName": { "$ref": "#/$defs/nullableText" },
        "firstSeenAt": { "$ref": "#/$defs/isoTime" },
        "lastSeenAt": { "$ref": "#/$defs/isoTime" }
      }
    },
    "ordinaryScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "hostId", "target", "boardId"],
      "properties": {
        "accountId": { "$ref": "#/$defs/safeId" },
        "hostId": { "$ref": "#/$defs/host" },
        "target": { "enum": ["posted", "collected", "liked"] },
        "boardId": { "type": "null" }
      }
    },
    "albumScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "hostId", "target", "boardId"],
      "properties": {
        "accountId": { "$ref": "#/$defs/safeId" },
        "hostId": { "$ref": "#/$defs/host" },
        "target": { "const": "collected_album" },
        "boardId": { "$ref": "#/$defs/safeId" }
      }
    },
    "scope": { "oneOf": [{ "$ref": "#/$defs/ordinaryScope" }, { "$ref": "#/$defs/albumScope" }] },
    "ordinaryMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "boardId", "boardName", "observedAt"],
      "properties": {
        "target": { "enum": ["posted", "collected", "liked"] },
        "boardId": { "type": "null" },
        "boardName": { "type": "null" },
        "observedAt": { "$ref": "#/$defs/isoTime" }
      }
    },
    "albumMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "boardId", "boardName", "observedAt"],
      "properties": {
        "target": { "const": "collected_album" },
        "boardId": { "$ref": "#/$defs/safeId" },
        "boardName": { "$ref": "#/$defs/nullableText" },
        "observedAt": { "$ref": "#/$defs/isoTime" }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "publicUrl"],
      "properties": {
        "id": { "$ref": "#/$defs/nullableText" },
        "name": { "$ref": "#/$defs/nullableText" },
        "publicUrl": { "oneOf": [{ "type": "string", "format": "uri" }, { "type": "null" }] }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liked", "collected", "commented", "shared"],
      "properties": {
        "liked": { "$ref": "#/$defs/metric" },
        "collected": { "$ref": "#/$defs/metric" },
        "commented": { "$ref": "#/$defs/metric" },
        "shared": { "$ref": "#/$defs/metric" }
      }
    },
    "noteInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "accountId", "hostId", "noteId", "publicUrl", "title", "body", "noteType", "author", "publishedAt", "updatedAt", "capturedAt", "tags", "metrics", "memberships"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "accountId": { "$ref": "#/$defs/safeId" },
        "hostId": { "$ref": "#/$defs/host" },
        "noteId": { "$ref": "#/$defs/safeId" },
        "publicUrl": { "type": "string", "format": "uri" },
        "title": { "$ref": "#/$defs/nullableText" },
        "body": { "type": "string" },
        "noteType": { "enum": ["text", "image", "video", "mixed", "unknown"] },
        "author": { "$ref": "#/$defs/author" },
        "publishedAt": { "$ref": "#/$defs/nullableTime" },
        "updatedAt": { "$ref": "#/$defs/nullableTime" },
        "capturedAt": { "$ref": "#/$defs/isoTime" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "metrics": { "$ref": "#/$defs/metrics" },
        "memberships": {
          "type": "array",
          "items": { "oneOf": [{ "$ref": "#/$defs/ordinaryMembership" }, { "$ref": "#/$defs/albumMembership" }] }
        }
      }
    },
    "listFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "retryAt"],
      "properties": {
        "category": { "enum": ["AUTH_REQUIRED", "RATE_LIMITED", "NETWORK", "PROTOCOL"] },
        "retryAt": { "$ref": "#/$defs/nullableTime" }
      },
      "allOf": [{ "if": { "properties": { "category": { "not": { "const": "RATE_LIMITED" } } }, "required": ["category"] }, "then": { "properties": { "retryAt": { "type": "null" } } } }]
    },
    "detailFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "retryAt"],
      "properties": {
        "category": { "enum": ["AUTH_REQUIRED", "RATE_LIMITED", "NETWORK", "PROTOCOL", "DETAIL", "EXPORT"] },
        "retryAt": { "$ref": "#/$defs/nullableTime" }
      },
      "allOf": [{ "if": { "properties": { "category": { "not": { "const": "RATE_LIMITED" } } }, "required": ["category"] }, "then": { "properties": { "retryAt": { "type": "null" } } } }]
    },
    "mediaFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "retryAt"],
      "properties": { "category": { "const": "MEDIA" }, "retryAt": { "type": "null" } }
    },
    "mediaSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ordinal", "mediaId", "relativePath"],
      "properties": {
        "kind": { "enum": ["cover", "image", "video"] },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "mediaId": { "$ref": "#/$defs/safeId" },
        "relativePath": { "$ref": "#/$defs/relativePath" }
      }
    },
    "mediaFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ordinal", "mediaId", "failure"],
      "properties": {
        "kind": { "enum": ["cover", "image", "video"] },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "mediaId": { "$ref": "#/$defs/safeId" },
        "failure": { "$ref": "#/$defs/mediaFailure" }
      }
    },
    "detailSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note", "revisionAt", "claimedPayloadSha256", "mediaSetComplete", "media"],
      "properties": {
        "note": { "$ref": "#/$defs/noteInput" },
        "revisionAt": { "$ref": "#/$defs/nullableTime" },
        "claimedPayloadSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "mediaSetComplete": { "type": "boolean" },
        "media": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/mediaSuccess" }, { "$ref": "#/$defs/mediaFailed" }] } }
      }
    },
    "pageDetailFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noteId", "failure"],
      "properties": {
        "noteId": { "$ref": "#/$defs/safeId" },
        "failure": { "$ref": "#/$defs/detailFailure" }
      }
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noteId"],
      "properties": { "noteId": { "$ref": "#/$defs/safeId" } }
    },
    "normalPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "requestCursor", "nextCursor", "hasMore", "items", "details"],
      "properties": {
        "scope": { "$ref": "#/$defs/scope" },
        "requestCursor": { "$ref": "#/$defs/nullableCursor" },
        "nextCursor": { "$ref": "#/$defs/nullableCursor" },
        "hasMore": { "type": "boolean" },
        "items": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/listItem" } },
        "details": { "type": "array", "maxItems": 10, "items": { "oneOf": [{ "$ref": "#/$defs/detailSuccess" }, { "$ref": "#/$defs/pageDetailFailure" }] } }
      }
    },
    "failedPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "requestCursor", "nextCursor", "hasMore", "items", "details", "listFailure"],
      "properties": {
        "scope": { "$ref": "#/$defs/scope" },
        "requestCursor": { "$ref": "#/$defs/nullableCursor" },
        "nextCursor": { "$ref": "#/$defs/nullableCursor" },
        "hasMore": { "type": "boolean" },
        "items": { "type": "array", "maxItems": 0 },
        "details": { "type": "array", "maxItems": 0 },
        "listFailure": { "$ref": "#/$defs/listFailure" }
      }
    },
    "page": { "oneOf": [{ "$ref": "#/$defs/normalPage" }, { "$ref": "#/$defs/failedPage" }] },
    "retryFailureWrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure"],
      "properties": { "failure": { "$ref": "#/$defs/detailFailure" } }
    },
    "retryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "noteId", "detail"],
      "properties": {
        "scope": { "$ref": "#/$defs/scope" },
        "noteId": { "$ref": "#/$defs/safeId" },
        "detail": { "oneOf": [{ "$ref": "#/$defs/detailSuccess" }, { "$ref": "#/$defs/retryFailureWrapper" }] }
      }
    }
  }
}
