{
  "name": "rednote-sync-core",
  "version": "0.0.0-stage3",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26 <27"
  },
  "os": [
    "darwin"
  ],
  "type": "module",
  "bin": {
    "rednote-sync": "./dist/bin.js"
  },
  "files": [
    "dist/",
    "docs/offline-input-v1.md",
    "schemas/offline-input-v1.schema.json",
    "examples/offline-v1/"
  ],
  "scripts": {
    "build:dist": "node scripts/build-dist.mjs --write",
    "build:check": "node scripts/build-dist.mjs --check",
    "check": "npm run typecheck && npm run build:check && node scripts/static-check.mjs && node scripts/offline-artifact-check.mjs && node scripts/offline-artifact-check-test.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "test:release": "node --test --test-concurrency=1 tests/release-*.test.ts",
    "pack:check": "node scripts/pack-check.mjs",
    "test:offline-artifact": "node scripts/offline-artifact-check-test.mjs",
    "test:offline-demo": "node scripts/offline-demo-test.mjs",
    "test:readme-smoke": "node scripts/readme-smoke-test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "6.0.2"
  }
}
